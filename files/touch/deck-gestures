#!/usr/bin/env bash
# Touchscreen gestures, via lisgd.
#
# THE GAP THIS FILLS. niri handles 3-finger and 4-finger swipes itself, but it
# reads them from libinput POINTER gesture events, and libinput only synthesises
# those for touchpads. A touchscreen emits none, ever, so every one of those
# gestures is dead on a deck whose only pointer is the panel. lisgd reads the
# touch device directly and turns the contacts into commands, which is why it
# exists at all (its own man page says as much: "the synthetic gestures you
# define via lisgd can be used on touchscreens, which normal libinput gestures
# don't support").
#
# It OBSERVES the device rather than grabbing it, so taps, drags and scrolling
# still reach niri and the applications underneath. Nothing here takes input
# away from anything.
#
# The bindings mirror what the Perixx touchpad would do if it were plugged in,
# so the two input paths do not need separate muscle memory. Directions follow
# natural-scroll, which is set in config.kdl: fingers move the view, not the
# cursor, so swiping UP goes DOWN the workspace list.
set -eu

# Stable by-id path, not /dev/input/event4. Event numbers are assigned at probe
# time: this same panel registers TWO nodes (event4 touch, event5 keyboard) and
# DESIGN §9 already documents a case where probe order moved a device between
# reboots and pointed a daemon at the wrong one.
DEVICE="${DEVICE:-/dev/input/by-id/usb-TSTP_MTouch_CMTP_1.0-event-if00}"
if [ ! -e "$DEVICE" ]; then
    DEVICE="$(ls /dev/input/by-id/*MTouch*event-if00 2>/dev/null | head -1 || true)"
fi
[ -n "$DEVICE" ] && [ -e "$DEVICE" ] || {
    echo "deck-gestures: no touchscreen found under /dev/input/by-id" >&2
    exit 1
}

# ONE FINGER ONLY, and that is a hardware finding rather than a preference.
# Multi-finger gestures were tried on the panel on 2026-09-29 and did not work:
# two and three contacts get taken as a PINCH by whatever is on screen (this is
# a browser most of the time, and QtWebEngine treats any second contact as zoom)
# long before lisgd decides a swipe happened. lisgd also wants the contacts to
# travel nearly parallel, so any drift apart registers as a pinch and not a
# swipe. The net effect of the three-finger bindings was accidental zoom.
#
# niri's own 3-finger and 4-finger gestures are unaffected and still correct;
# they run on libinput pointer gesture events off a TOUCHPAD and never see this
# path. See the gestures comment in config/niri/config.kdl.
#
# What is left is the two that work, and they work because they are anchored to
# an edge: one contact, starting somewhere nothing else is listening.
#
# If you want the columns on a gesture too, the same edge trick is available and
# is the only shape worth trying on this panel:
#     -g "1,LR,L,*,R,deck-niri focus-column-left" \
#     -g "1,RL,R,*,R,deck-niri focus-column-right"
# Left off by default because lisgd does not grab the device, so those fire IN
# ADDITION to whatever the page underneath does with a drag from the edge.
#
# -g nfingers,gesture,edge,distance,actmode,command
exec lisgd -d "$DEVICE" \
    -g "1,DU,B,*,R,deck-osk" \
    -g "1,UD,T,*,R,deck-niri toggle-overview"
