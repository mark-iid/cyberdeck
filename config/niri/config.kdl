// cyberdeck — niri config for the Raspberry Pi 5 deck.
//
// Descended from ~/src/kb3lyb's /etc/niri/config.kdl, but the parts that matter
// most are the parts that DIVERGE. That config was written for a two-head 1080p
// desk. This is one 1280x800 touchscreen. Read DESIGN.md §2 before "fixing"
// anything here that looks unlike the parent.

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    // NO touchpad block. There is no touchpad and no mouse — a USB keyboard
    // ("TSTP MTouch ... -event-kbd") and a USB touchscreen ("TSTP MTouch"),
    // which are two interfaces of the same physical device.
    //
    // focus-follows-mouse is DELIBERATELY OMITTED, unlike both parent configs.
    // With a touchscreen the "pointer" teleports to wherever you last touched
    // and stays there. focus-follows-mouse would then hand focus to whatever
    // window happens to sit under that stale point — so typing would go
    // somewhere you are not looking. Keyboard focus only.
    touch {
        // Map touch input to the panel explicitly. Harmless with one output,
        // but if an HDMI monitor is ever plugged into HDMI-A-2 the touchscreen
        // must not start driving the wrong screen.
        map-to-output "HDMI-A-1"
    }
}

// DISPLAY — read off the machine 2026-08-31 via `wlr-randr`.
//
//   HDMI-A-1, "RTK CX101", 1280x800@60 preferred, physical 220x130mm (~148 DPI)
//   HDMI-A-2 is disconnected.
//
// SCALE 1 IS NOT A STYLE CHOICE — it is forced by WSJT-X. Decoded from this
// machine's own ~/.config/WSJT-X.ini, the main window's saved geometry is
// 880x685. At scale 1.25 the logical desktop would be 1024x640, and 685 > 640:
// the WSJT-X main window would not fit vertically even on an empty screen.
// Legibility is bought back with font sizes in foot/waybar instead.
output "HDMI-A-1" {
    mode "1280x800@59.996"
    scale 1
    position x=0 y=0
}

environment {
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    MOZ_ENABLE_WAYLAND "1"
    // Qt5 apps (wsjtx, jtdx, MSHV, gqrx are ALL Qt5 on this machine) render
    // natively on Wayland via the qtwayland5 plugin, which is installed.
    // Without that package this line makes every Qt app refuse to start.
    QT_QPA_PLATFORM "wayland"
    // XWayland via xwayland-satellite, for fldigi (FLTK) and chirp (wxPython).
    DISPLAY ":0"
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

layout {
    // gaps 8 -> 4. On a 1280px-wide panel, 8px gaps cost real estate that the
    // ham apps need. This is the single most-felt difference from the parent.
    gaps 4
    center-focused-column "never"

    // The parent's presets are 0.33/0.5/0.66. On 1280px those are 427/640/853px
    // columns, and WSJT-X alone wants 880. So the presets start at half and go
    // to FULL width: on a screen this size the normal case is one app at a time.
    preset-column-widths {
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }
    default-column-width { proportion 1.0; }

    focus-ring {
        width 2
        active-color "#7aa2f7"
        inactive-color "#505050"
    }
}

spawn-at-startup "xwayland-satellite"

// waybar is spawned HERE and its Debian systemd unit is DISABLED.
// Both fire otherwise: niri-session pulls in xdg-desktop-autostart.target and
// the user manager also starts waybar.service, which ships enabled. That gave
// two bars stacked on one 800px panel — observed 2026-08-31, PIDs in
// app-niri-waybar-*.scope and waybar.service respectively. One source of truth;
// this file is it, because the bar's config lives in this repo beside it.
//   systemctl --user disable --now waybar.service
spawn-at-startup "waybar"

spawn-at-startup "mako"

// NO POLKIT AGENT SPAWNED HERE, deliberately. Raspberry Pi OS autostarts
// lxpolkit via /etc/xdg/autostart/lxpolkit.desktop, and niri-session runs
// xdg-desktop-autostart.target, so an agent is ALREADY provided. Spawning
// polkit-mate as well gave two agents racing for the same D-Bus name.
// The parent kb3lyb config spawns one because Fedora Sway Atomic has no
// equivalent autostart — that premise does not hold on this platform.

spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"

// nm-applet: /etc/xdg/autostart/nm-applet.desktop exists but launches the
// plain applet, which uses the dead XEmbed tray. --indicator uses the
// StatusNotifierItem path waybar understands, so this spawn is kept and is
// not a duplicate — verified exactly one instance running.
spawn-at-startup "nm-applet" "--indicator"

// Wallpaper, if one exists. Absent file -> swaybg exits, desktop is plain.
spawn-at-startup "sh" "-c" "swaybg -i \"$HOME/Pictures/wallpaper.jpg\" -m fill || true"

// ---------------------------------------------------------------------------
// WINDOW RULES
//
// !! EVERY app-id BELOW IS UNVERIFIED. niri matches Wayland app-id, and for
// Xwayland clients the WM_CLASS *instance* — which is the executable name, not
// the pretty class name. On first login open each app and run:
//
//     niri msg windows
//
// A rule that matches nothing fails SILENTLY. That is exactly how the parent
// config rotted: it carries a comment about a "Mod+W wsjtx-layout" script that
// does not exist in any .kdl and is not in files/scripts/. Check, do not assume.

// --- Weak-signal digital: the three-way comparison (DESIGN.md §3) -----------
// WSJT-X is two windows (main 880x685 + WideGraph 938x337 = 1022px stacked,
// against ~770px usable). They CANNOT both be tiled here. So the main window
// tiles full-width and the waterfall FLOATS on top, summoned when needed.
window-rule {
    match app-id=r#"^(?i)wsjt-?x$"#
    open-floating false
    default-column-width { proportion 1.0; }
}
window-rule {
    match app-id=r#"^(?i)wsjt-?x$"# title=r#"Wide Graph"#
    open-floating true
    default-column-width { fixed 1272; }
    default-window-height { fixed 200; }
}

// WSJT-X's Settings dialog saves as 1280x811 — TALLER THAN THE 800px PANEL.
// Float it so it is at least movable; you may still have to scroll it.
// This is the most likely thing to bite in the field. Verify early.
window-rule {
    match app-id=r#"^(?i)wsjt-?x$"# title=r#"^Settings"#
    open-floating true
}

window-rule {
    match app-id=r#"^(?i)jtdx$"#
    open-floating false
    default-column-width { proportion 1.0; }
}

// MSHV: the whole reason it is a candidate is that the waterfall is INSIDE the
// main window (Ctrl+W toggles it, Ctrl+T the TX widget, both states saved).
// One window, so it just tiles. No float rules needed — that is the point.
window-rule {
    match app-id=r#"^(?i)mshv$"#
    open-floating false
    default-column-width { proportion 1.0; }
}

// --- The rest of the ham stack ----------------------------------------------
// fldigi is FLTK/X11 but resizes normally, so it tiles (matching the parent's
// 2026-08-27 correction). flrig/flmsg/flamp are small fixed control panels.
window-rule {
    match app-id=r#"^(?i)fldigi$"#
    open-floating false
    default-column-width { proportion 1.0; }
}
window-rule {
    match app-id=r#"^(?i)(flrig|flmsg|flamp)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(?i)js8call$"#
    open-floating false
    default-column-width { proportion 1.0; }
}

// SDR receivers want width for a spectrum display. On 1280px "wide" means the
// whole screen, so they are maximised rather than floated at a remembered size
// that was chosen on a bigger monitor.
window-rule {
    match app-id=r#"^(?i)(gqrx|sdrpp|sdrangel)$"#
    open-maximized true
}

window-rule {
    match app-id=r#"^(?i)(chirp|klog|tqsl|gpredict|xastir)$"#
    open-floating false
}

// --- Reference material -----------------------------------------------------
// kiwix-desktop holds 123GB of ZIMs and is the deck's actual purpose as much as
// the radio is. Full width, its own workspace by habit.
window-rule {
    match app-id=r#"^(?i).*kiwix.*$"#
    open-maximized true
}

// Transient dialogs from anything above, matched on title because the app-id
// belongs to the parent app. On an 800px panel these must float or they shove
// the app they belong to out of the way.
window-rule {
    match title=r#"^(Settings|Preferences|Configure|Rig|Audio|About|Error|Warning)"#
    open-floating true
}

cursor {
    xcursor-size 24
    // The pointer is a touch artefact most of the time — get it out of the way.
    hide-when-typing
}

hotkey-overlay {
    skip-at-startup
}

// ---------------------------------------------------------------------------
// BINDS
//
// This deck has NO MOUSE and NO TITLEBARS (prefer-no-csd), so window management
// is 100% keyboard. That makes Mod+Shift+Slash — the hotkey overlay — the deck's
// actual manual, and the reason EVERY spawn bind below carries an explicit
// hotkey-overlay-title. Action binds are self-describing; spawns are not, and
// an untitled spawn shows up in the overlay as a bare command line.
//
// RULE FOR THIS FILE: no `spawn` without a `hotkey-overlay-title`.

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+D      hotkey-overlay-title="Run an application" { spawn "fuzzel"; }
    Mod+Escape hotkey-overlay-title="Lock the screen" { spawn "gtklock"; }

    Mod+V hotkey-overlay-title="Clipboard history" {
        spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy";
    }

    // --- The deck's own apps, on the number row's neighbours ----------------
    Mod+B hotkey-overlay-title="Kiwix — offline Wikipedia & manuals" { spawn "kiwix-desktop"; }
    Mod+M hotkey-overlay-title="MSHV — FT8/FT4 (waterfall: Ctrl+W)"  { spawn "mshv"; }
    Mod+N hotkey-overlay-title="WSJT-X — FT8/FT4"                    { spawn "wsjtx"; }

    Mod+Q { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    Mod+R       { switch-preset-column-width; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Reclaim waybar's ~30px. On a 800px panel that is the difference between
    // the WSJT-X main window fitting and not.
    Mod+Shift+B hotkey-overlay-title="Toggle the bar (reclaim 30px)" {
        spawn "sh" "-c" "pkill -USR1 waybar";
    }

    // Escape hatch for X11 apps that fullscreen themselves and re-assert it.
    Mod+Shift+X hotkey-overlay-title="Force-clear a stuck X11 fullscreen" {
        spawn "wmctrl" "-r" ":ACTIVE:" "-b" "remove,fullscreen";
    }

    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Audio is HDMI-only right now (vc4hdmi0/vc4hdmi1); a USB codec for the
    // radio appears as a new sink when plugged in. No backlight control on this
    // panel, so the parent's XF86MonBrightness* binds are omitted rather than
    // left pointing at a binary that would do nothing.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
