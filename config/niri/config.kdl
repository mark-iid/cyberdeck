// cyberdeck — niri config for the Raspberry Pi 5 deck.
//
// Descended from ~/src/kb3lyb's /etc/niri/config.kdl, but the parts that matter
// most are the parts that DIVERGE. That config was written for a two-head 1080p
// desk. This is one 1280x800 touchscreen. Read DESIGN.md §2 before "fixing"
// anything here that looks unlike the parent.

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    // INPUT MODEL. Two pointer sources may be present:
    //   - the touchscreen (built in, always there)
    //   - a Perixx PERIBOARD-510H Plus: wired USB mini keyboard with a TOUCHPAD
    //     and 2 USB hubs. Preferred over the BT keyboard — wired means no
    //     pairing and no battery, and the touchpad gives a real pointer for the
    //     fine work touch is bad at (qutebrowser clicks, gqrx sliders).
    //
    // The touchpad block below is INERT until such a device is plugged in, so it
    // is safe to ship now. tap-to-click and natural-scroll match a laptop feel.
    touchpad {
        tap
        natural-scroll
        dwt   // disable-while-typing: ignore the pad while the keys are active
    }

    // focus-follows-mouse is STILL omitted, and now for a subtler reason. With a
    // touchpad added, a deliberate pointer exists — but the touchSCREEN pointer
    // still teleports to the last tap and stays there. Mixing the two with
    // focus-follows-mouse would let a stale touch-point steal focus from where
    // the touchpad left it. Keyboard/click focus stays authoritative; the pointer
    // (either source) acts only on an explicit tap or click.
    touch {
        // Map touch to the panel explicitly, so a future HDMI-A-2 monitor does
        // not start driving the wrong screen.
        map-to-output "HDMI-A-1"
    }
}

// GESTURES (verified 2026-09-29 against this build's OWN source tree at
// ~/.cache/cyberdeck-build/niri, v26.04, not against the wiki). The split
// below is the thing to know before adding any more gesture config here:
//
//   TOUCHPAD  -> libinput POINTER gesture events, which niri handles itself in
//                src/input/mod.rs (on_gesture_swipe_begin/update):
//                  3-finger vertical   = switch workspaces
//                  3-finger horizontal = scroll columns
//                  4-finger            = the Overview
//                `natural-scroll` in the touchpad block above inverts these too
//                (the handler negates both deltas when it is set), so 3-finger
//                down goes to the workspace above, the way macOS does it.
//                NONE of this is reachable today: `libinput list-devices` on
//                2026-09-29 showed only "TSTP MTouch", the HDMI jacks, the power
//                button and the RTL-SDR. The Perixx is not plugged in.
//
//   TOUCHSCREEN -> emits none of those events, ever. Not a niri limitation to
//                work around in this file: libinput only synthesises pointer
//                gestures for touchpads. The panel itself is willing, being a
//                10-point MT-B device (ABS_MT_SLOT max 9, read off
//                /dev/input/event4), so the fingers are there and nothing
//                consumes them. bin/59-touch-input.sh fills that gap with lisgd,
//                which reads the touch device directly.
//
// HOT CORNERS ARE POINTER-ONLY, for the same reason and one more: the trigger
// lives entirely in the pointer-motion path (`pointer_inside_hot_corner`,
// src/input/mod.rs ~2389-2709) and the target is a 1x1 px rect at (0,0) that
// only a clamped cursor can land on. A finger cannot hit it. Stated out loud
// because niri defaults top-left ON when no corner is named, so a config that
// says nothing here still HAS a hot corner, it just does not admit it.
gestures {
    hot-corners {
        top-left
    }
}

// DISPLAY — read off the machine 2026-08-31 via `wlr-randr`.
//
//   HDMI-A-1, "RTK CX101", 1280x800@60 preferred, physical 220x130mm (~148 DPI)
//   HDMI-A-2 is disconnected.
//
// SCALE 1 IS NOT A STYLE CHOICE — it is forced by WSJT-X. Decoded from this
// machine's own ~/.config/WSJT-X.ini, the main window's saved geometry is
// 880x685. At scale 1.25 the logical desktop would be 1024x640, and 685 > 640:
// the WSJT-X main window would not fit vertically even on an empty screen.
// Legibility is bought back with font sizes in foot/waybar instead.
output "HDMI-A-1" {
    mode "1280x800@59.996"
    scale 1
    position x=0 y=0
}

environment {
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    MOZ_ENABLE_WAYLAND "1"
    // Qt5 apps (wsjtx, jtdx, MSHV, gqrx are ALL Qt5 on this machine) render
    // natively on Wayland via the qtwayland5 plugin, which is installed.
    // Without that package this line makes every Qt app refuse to start.
    QT_QPA_PLATFORM "wayland"
    // XWayland via xwayland-satellite, for fldigi (FLTK) and chirp (wxPython).
    DISPLAY ":0"
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

layout {
    // gaps 8 -> 4. On a 1280px-wide panel, 8px gaps cost real estate that the
    // ham apps need. This is the single most-felt difference from the parent.
    gaps 4
    center-focused-column "never"

    // The parent's presets are 0.33/0.5/0.66. On 1280px those are 427/640/853px
    // columns, and WSJT-X alone wants 880. So the presets start at half and go
    // to FULL width: on a screen this size the normal case is one app at a time.
    preset-column-widths {
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }
    default-column-width { proportion 1.0; }

    focus-ring {
        width 2
        active-color "#7aa2f7"
        inactive-color "#505050"
    }
}

spawn-at-startup "xwayland-satellite"

// waybar is spawned HERE and its Debian systemd unit is DISABLED.
// Both fire otherwise: niri-session pulls in xdg-desktop-autostart.target and
// the user manager also starts waybar.service, which ships enabled. That gave
// two bars stacked on one 800px panel — observed 2026-08-31, PIDs in
// app-niri-waybar-*.scope and waybar.service respectively. One source of truth;
// this file is it, because the bar's config lives in this repo beside it.
//   systemctl --user disable --now waybar.service
spawn-at-startup "waybar"

spawn-at-startup "mako"

// NO POLKIT AGENT SPAWNED HERE, deliberately. Raspberry Pi OS autostarts
// lxpolkit via /etc/xdg/autostart/lxpolkit.desktop, and niri-session runs
// xdg-desktop-autostart.target, so an agent is ALREADY provided. Spawning
// polkit-mate as well gave two agents racing for the same D-Bus name.
// The parent kb3lyb config spawns one because Fedora Sway Atomic has no
// equivalent autostart — that premise does not hold on this platform.

spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"

// nm-applet: /etc/xdg/autostart/nm-applet.desktop exists but launches the
// plain applet, which uses the dead XEmbed tray. --indicator uses the
// StatusNotifierItem path waybar understands, so this spawn is kept and is
// not a duplicate — verified exactly one instance running.
spawn-at-startup "nm-applet" "--indicator"

// Wallpaper, if one exists. Absent file -> swaybg exits, desktop is plain.
spawn-at-startup "sh" "-c" "swaybg -i \"$HOME/Pictures/wallpaper.jpg\" -m fill || true"

// The launcher page (bin/58-landing-page.sh, deckpage.service on :8000), opened
// at boot onto the "web" workspace declared below. This is the deck's answer to
// having no mouse and, half the time, no keyboard: every local resource, every
// installed radio app and 300 ZIMs, as targets a finger can hit.
//
// Costs about 200 MB resident out of 7.9 GB, of which 6.0 GB was free when this
// was measured, so a browser that is always there is affordable now in a way it
// would not have been on a 2 GB Pi.
spawn-at-startup "qutebrowser" "http://127.0.0.1:8000"

// The on-screen keyboard, started hidden so the first bottom-edge swipe does not
// pay process startup. wvkbd and not squeekboard (which is installed): an
// input-method keyboard only appears when a client asks through text-input-v3,
// and no XWayland client ever asks, so it would stay silent for exactly the
// programs you are stuck with when the real keyboard is in the lid. See
// bin/59-touch-input.sh.
spawn-at-startup "deck-osk" "--boot"

// ---------------------------------------------------------------------------
// NAMED WORKSPACE for the launcher page (bin/58-landing-page.sh, served on
// :8000). qutebrowser is spawned at startup and pinned here, so the deck boots
// showing every local resource it has, and the radio stack never shares a
// workspace with a browser that wants all 1272 px.
//
// !! THIS SHIFTS THE WORKSPACE INDICES. Named workspaces are inserted at the
// FRONT: Layout::ensure_named_workspace calls `mon.insert_workspace(ws, 0,
// false)` (src/layout/mod.rs). So "web" IS workspace 1, and everything the
// number row used to reach moved up by one. The Mod+1 bind below was changed to
// address it BY NAME rather than by index, so this stays true no matter how
// many named workspaces get added later.
workspace "web"

// ---------------------------------------------------------------------------
// WINDOW RULES
//
// !! EVERY app-id BELOW IS UNVERIFIED. niri matches Wayland app-id, and for
// Xwayland clients the WM_CLASS *instance* — which is the executable name, not
// the pretty class name. On first login open each app and run:
//
//     niri msg windows
//
// A rule that matches nothing fails SILENTLY. That is exactly how the parent
// config rotted: it carries a comment about a "Mod+W wsjtx-layout" script that
// does not exist in any .kdl and is not in files/scripts/. Check, do not assume.

// --- Weak-signal digital ----------------------------------------------------
// DECIDED 2026-08-31 (DESIGN §3): MSHV is the primary FT8/FT4 program. It opens
// ONE window with the waterfall inside it (Ctrl+W toggles), where WSJT-X and
// JTDX each open two and need the second placed by hand on a 776px-usable panel.
// Verified with `niri msg windows`, not assumed.
//
// WSJT-X stays as the reference implementation and insurance; its rules below
// are verified working. JTDX is a WSJT-X fork and duplicates that fallback
// rather than adding one, and I don't intend to use it.
// WSJT-X is two windows (main 880x685 + WideGraph 938x337 = 1022px stacked,
// against ~770px usable). They CANNOT both be tiled here. So the main window
// tiles full-width and the waterfall FLOATS on top, summoned when needed.
window-rule {
    match app-id=r#"^(?i)wsjt-?x$"#
    open-floating false
    default-column-width { proportion 1.0; }
}
window-rule {
    match app-id=r#"^(?i)wsjt-?x$"# title=r#"Wide Graph"#
    open-floating true
    default-column-width { fixed 1272; }
    default-window-height { fixed 200; }
}

// WSJT-X's Settings dialog: MEASURED at 1280x813 on a 776px usable area
// (`niri msg windows`, 2026-08-31). The .ini decode predicted 811, so this is
// real and it does not fit.
//
// THIS RULE DOES NOT FIRE, and the reason is worth recording rather than
// silently deleting. niri evaluates open-* properties ONCE, at map time, and Qt
// sets this dialog's title AFTER mapping — so at the moment the rule is tested
// the title is not yet "Settings". Both this rule and the generic
// ^(Settings|Preferences|...) rule near the bottom of this file miss it for the
// same reason. Title-based open-floating is unreliable for late-titled dialogs.
//
// Kept as documentation of a known limitation, and because it costs nothing if
// a future Qt/niri combination titles the window earlier. The working answer is
// the Mod+Space bind (toggle-window-floating) in the binds block: float it by
// hand once it is on screen. That works regardless of when the title arrives.
window-rule {
    match app-id=r#"^(?i)wsjt-?x$"# title=r#"^Settings"#
    open-floating true
}

// JTDX rules REMOVED 2026-08-31 along with the package. It is a WSJT-X fork, so
// it duplicated the fallback rather than adding one, and I do not
// use it (DESIGN §3). The rules were verified working before removal -- app-id
// "jtdx", waterfall floated at 1272x202 -- so if `apt install jtdx` ever brings
// it back, mirror the WSJT-X pair above rather than rediscovering it.

// MSHV: the whole reason it is a candidate is that the waterfall is INSIDE the
// main window (Ctrl+W toggles it, Ctrl+T the TX widget, both states saved).
// One window, so it just tiles. No float rules needed — that is the point.
window-rule {
    match app-id=r#"^(?i)mshv$"#
    open-floating false
    default-column-width { proportion 1.0; }
}

// --- The rest of the ham stack ----------------------------------------------
// fldigi is FLTK/X11 but resizes normally, so it tiles (matching the parent's
// 2026-08-27 correction). flrig/flmsg/flamp are small fixed control panels.
window-rule {
    match app-id=r#"^(?i)fldigi$"#
    open-floating false
    default-column-width { proportion 1.0; }
}
window-rule {
    match app-id=r#"^(?i)(flrig|flmsg|flamp)$"#
    open-floating true
}

// fldigi's own dialogs. VERIFIED app-id is "Fldigi" with a capital F
// (niri msg windows, 2026-08-31) — the (?i) above is doing real work, not
// defensive noise. The configuration wizard opened TILED at 600x380 and shoved
// the main window aside; FLTK sets these titles at map time, so unlike the Qt
// case above this match does fire.
window-rule {
    match app-id=r#"^(?i)fldigi$"# title=r#"(?i)(configuration|wizard|dialog)"#
    open-floating true
}

window-rule {
    match app-id=r#"^(?i)js8call$"#
    open-floating false
    default-column-width { proportion 1.0; }
}

// SDR receivers want width for a spectrum display. On 1280px "wide" means the
// whole screen, so they are maximised rather than floated at a remembered size
// that was chosen on a bigger monitor.
window-rule {
    match app-id=r#"^(?i)(gqrx|sdrpp|sdrangel)$"#
    open-maximized true
}

window-rule {
    match app-id=r#"^(?i)(chirp|klog|tqsl|gpredict|xastir)$"#
    open-floating false
}

// QLog (bin/35-build-qlog.sh), the logger this deck uses. app-id is "QLog",
// capital Q and L, VERIFIED with `niri msg windows` on 2026-09-29 and not
// guessed from the binary name, which is lowercase.
//
// The main window is the good news and it is worth recording because the
// obvious prior was wrong: measured at 1272x768, the FULL default layout fits
// on this panel with nothing clipped, logbook table, QSO entry, the detail
// tabs, the clock dock and the grid-square map all visible at once. Unlike
// WSJT-X (§3) there is nothing to work around here.
window-rule {
    match app-id=r#"^QLog$"#
    open-floating false
    default-column-width { proportion 1.0; }
}

// Its Settings dialog is the WSJT-X problem again, measured rather than feared:
// 800x882 against 768 px of usable height, so it overflows the bottom by about
// 114 px and takes its buttons with it. First run opens it automatically.
//
// It DOES float, which is the part that differs from WSJT-X. The generic
// ^(Settings|...) rule further down already catches it, because QLog sets the
// title at map time where Qt's own dialog in WSJT-X sets it afterwards. That is
// the same late-title behaviour documented up at the WSJT-X rules, landing on
// the other side of the line for once.
//
// Escape closes it, and that is the answer that always works.
//
// !! THE HEIGHT CAP BELOW IS UNVERIFIED, said out loud because this file has a
// standing rule against decoration that looks like it does something. The
// dialog's own constraints permit it: ui/SettingsDialog.ui declares geometry
// 800x836, minimumSize 770x0 and maximumSize 800x16777215, so there is no
// explicit minimum HEIGHT to fight. What is not known is whether the tab
// pages' layouts impose an implicit one, which would clamp this silently. It
// could not be triggered to find out, because QLog gives Settings no keyboard
// shortcut (ui/MainWindow.ui) and it is reachable only through the menu.
//
// So: open Settings once, run `niri msg windows`, and either delete this rule
// or delete this comment.
window-rule {
    match app-id=r#"^QLog$"# title=r#"^Settings"#
    open-floating true
    default-window-height { fixed 760; }
}

// --- Reference material -----------------------------------------------------
// kiwix-desktop holds 193GB of ZIMs and is the deck's actual purpose as much as
// the radio is. Full width, its own workspace by habit.
window-rule {
    match app-id=r#"^(?i).*kiwix.*$"#
    open-maximized true
}

// qutebrowser is the primary reader for the offline stack (DESIGN §7): the ZIM
// library on :8080 and the local model on :8081. Full width — it is reading
// long-form reference material on a 1280px panel.
// qutebrowser is the primary reader for the offline stack (DESIGN §7): ZIMs on
// :8080, the local model on :8081.
//
// app-id VERIFIED as "org.qutebrowser.qutebrowser" — NOT "qutebrowser". A rule
// anchored on the binary name matched nothing, silently. Reverse-DNS app-ids are
// normal for Wayland-native apps; never assume the executable name.
//
// NO open-maximized rule, deliberately. `default-column-width { proportion 1.0 }`
// above already makes every window full width: 1280 - 2*4px gaps = 1272, and
// 800 - 24px bar - 8px gaps = 768. Measured, foot (no rule) and qutebrowser
// (with one) were both 1272x768 — the rule changed nothing and was deleted
// rather than left as decoration that looks like it does something.
//
// It IS pinned to the "web" workspace though, which is a different claim: the
// launcher page on :8000 is spawned at startup and should never land on top of
// whatever radio app the number row is pointing at.
window-rule {
    match app-id=r#"^org\.qutebrowser\.qutebrowser$"#
    open-on-workspace "web"
}

// Transient dialogs from anything above, matched on title because the app-id
// belongs to the parent app. On an 800px panel these must float or they shove
// the app they belong to out of the way.
window-rule {
    match title=r#"^(Settings|Preferences|Configure|Rig|Audio|About|Error|Warning)"#
    open-floating true
}

cursor {
    xcursor-size 24
    // Hide the cursor only WHILE typing; the touchpad makes the pointer useful
    // the rest of the time, so it reappears the moment the pad or screen is used.
    hide-when-typing
}

hotkey-overlay {
    skip-at-startup
}

// ---------------------------------------------------------------------------
// BINDS
//
// This deck has NO MOUSE and NO TITLEBARS (prefer-no-csd), so window management
// is 100% keyboard. That makes Mod+Shift+Slash — the hotkey overlay — the deck's
// actual manual, and the reason EVERY spawn bind below carries an explicit
// hotkey-overlay-title. Action binds are self-describing; spawns are not, and
// an untitled spawn shows up in the overlay as a bare command line.
//
// RULE FOR THIS FILE: no `spawn` without a `hotkey-overlay-title`.

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+D      hotkey-overlay-title="Run an application" { spawn "fuzzel"; }
    Mod+Escape hotkey-overlay-title="Lock the screen" { spawn "gtklock"; }

    Mod+V hotkey-overlay-title="Clipboard history" {
        spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy";
    }

    // --- The deck's own apps, on the number row's neighbours ----------------
    // The offline stack, both in qutebrowser — see DESIGN §7. kiwix-desktop's
    // content area is a QtWebEngine view where following a link means
    // Tab-cycling past every preceding one; qutebrowser's link hints (press f,
    // type the letter) make that two keystrokes. On a deck with no mouse that is
    // the difference between usable and not.
    Mod+B hotkey-overlay-title="Kiwix library, 300 ZIMs (f = link hints)" {
        spawn "qutebrowser" "http://127.0.0.1:8080";
    }
    Mod+A hotkey-overlay-title="Local AI — 7B Mistral, offline" {
        spawn "qutebrowser" "http://127.0.0.1:8081";
    }
    // The way back to the launcher if it has been closed. Mod+1 alone only
    // moves to the workspace, which is no help once the window is gone.
    Mod+W hotkey-overlay-title="Launcher page (every local resource, tappable)" {
        spawn "qutebrowser" "http://127.0.0.1:8000";
    }
    // kiwix-desktop stays installed and is still in fuzzel (Mod+D) if wanted.
    Mod+M hotkey-overlay-title="MSHV — FT8/FT4, primary (waterfall: Ctrl+W)" { spawn "mshv"; }
    Mod+N hotkey-overlay-title="WSJT-X — FT8/FT4, fallback"                  { spawn "wsjtx"; }

    Mod+Q { close-window; }

    // THE OVERVIEW IS THIS MACHINE'S TOUCH AFFORDANCE, and the reason is that
    // touch works properly INSIDE it even though it cannot open it. Once open,
    // src/input/touch_overview_grab.rs takes over: drag to scroll columns, drag
    // vertically to change workspace, hold 500 ms then drag to move a window.
    // Windows become thumbnails you can hit with a finger instead of the ~4 mm
    // targets a 148 DPI panel otherwise gives you (1280 px across 220 mm is
    // 5.8 px/mm, so the 24 px bar is 4.1 mm and a focus ring is a third of a
    // millimetre). Opening it is the only part a bare touchscreen cannot do,
    // which is what this bind and lisgd's bottom-edge swipe are both for.
    Mod+O { toggle-overview; }

    // The keyboard, for when the real one is not attached. Also bound to a swipe
    // up from the bottom edge once deck-gestures is running, which is the one
    // that matters, since a keybind for an on-screen keyboard assumes the thing
    // it is replacing.
    Mod+I hotkey-overlay-title="On-screen keyboard, toggle" { spawn "deck-osk"; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // By name, not index: "web" is inserted at the front (see the workspace
    // declaration above), so `focus-workspace 1` would still land here but would
    // stop saying why. The other three stay numeric and now mean what used to be
    // 1, 2 and 3.
    Mod+1 { focus-workspace "web"; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace "web"; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // The reliable answer to any dialog that opens tiled when it should float.
    // Window rules can only act at map time, and several toolkits (Qt notably)
    // set their title afterwards, so no title-based rule can catch them. This
    // works whenever the window is on screen. See the WSJT-X Settings note above.
    Mod+Space hotkey-overlay-title="Float / unfloat this window" { toggle-window-floating; }

    Mod+R       { switch-preset-column-width; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Reclaim waybar's ~30px. On a 800px panel that is the difference between
    // the WSJT-X main window fitting and not.
    Mod+Shift+B hotkey-overlay-title="Toggle the bar (reclaim 30px)" {
        spawn "sh" "-c" "pkill -USR1 waybar";
    }

    // Escape hatch for X11 apps that fullscreen themselves and re-assert it.
    Mod+Shift+X hotkey-overlay-title="Force-clear a stuck X11 fullscreen" {
        spawn "wmctrl" "-r" ":ACTIVE:" "-b" "remove,fullscreen";
    }

    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Audio is HDMI-only right now (vc4hdmi0/vc4hdmi1); a USB codec for the
    // radio appears as a new sink when plugged in. No backlight control on this
    // panel, so the parent's XF86MonBrightness* binds are omitted rather than
    // left pointing at a binary that would do nothing.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
